---
// Obtenemos la ruta actual para saber en qué página estamos y resaltarla
const pathname = Astro.url.pathname;
---

<header class="fixed top-0 w-full z-50 bg-zinc-950/80 backdrop-blur-lg border-b border-zinc-800/50 transition-all">
    <div class="max-w-7xl mx-auto px-8 md:px-16 h-20 flex items-center justify-between">
        
        <!-- 1. Izquierda: Logo (Toma 1/3 del espacio) -->
        <div class="flex-1 flex justify-start">
            <a href="/" class="text-2xl font-bold tracking-tight text-white flex items-center transition-transform hover:scale-105">
                Melchisoft
            </a>
        </div>

        <!-- 2. Centro: Menú de Escritorio (Toma 1/3 del espacio y centra su contenido) -->
        <nav class="hidden md:flex flex-1 justify-center items-center gap-8">
            <a href="/servicios" class={`text-sm font-medium transition-colors ${pathname.includes('/servicios') ? 'text-emerald-400' : 'text-zinc-400 hover:text-zinc-100'}`}>
                Servicios
            </a>
            <a href="/nosotros" class={`text-sm font-medium transition-colors ${pathname.includes('/nosotros') ? 'text-emerald-400' : 'text-zinc-400 hover:text-zinc-100'}`}>
                Sobre Nosotros
            </a>
            <a href="/contacto" class={`text-sm font-medium transition-colors ${pathname.includes('/contacto') ? 'text-emerald-400' : 'text-zinc-400 hover:text-zinc-100'}`}>
                Contacto
            </a>
        </nav>

        <!-- 3. Derecha: Redes Sociales y Menú Móvil (Toma 1/3 del espacio y empuja a la derecha) -->
        <div class="flex-1 flex justify-end items-center gap-5">
            
            <!-- Facebook -->
            <a href="https://www.facebook.com/profile.php?id=61576128037791" target="_blank" rel="noopener noreferrer" class="text-zinc-400 hover:text-blue-500 transition-colors hidden sm:block" aria-label="Visitar Facebook">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.469h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.469h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                </svg>
            </a>

            <!-- WhatsApp -->
            <a href="https://wa.me/522941025503" target="_blank" rel="noopener noreferrer" class="text-zinc-400 hover:text-emerald-400 transition-colors" aria-label="Contactar por WhatsApp">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>
                </svg>
            </a>

            <!-- Botón Menú de Hamburguesa (Solo visible en Celulares) -->
            <button id="menu-btn" class="md:hidden text-zinc-400 hover:text-emerald-400 focus:outline-none transition-colors ml-2" aria-label="Abrir menú">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                </svg>
            </button>
        </div>

    </div>

    <!-- Menú Móvil Desplegable -->
    <div id="mobile-menu" class="hidden md:hidden bg-zinc-950 border-b border-zinc-800/50 absolute w-full shadow-2xl">
        <div class="px-8 py-6 flex flex-col gap-6">
            <a href="/servicios" class={`text-lg font-medium transition-colors ${pathname.includes('/servicios') ? 'text-emerald-400' : 'text-zinc-400 hover:text-zinc-100'}`}>
                Servicios
            </a>
            <a href="/nosotros" class={`text-lg font-medium transition-colors ${pathname.includes('/nosotros') ? 'text-emerald-400' : 'text-zinc-400 hover:text-zinc-100'}`}>
                Sobre Nosotros
            </a>
            <a href="/contacto" class={`text-lg font-medium transition-colors ${pathname.includes('/contacto') ? 'text-emerald-400' : 'text-zinc-400 hover:text-zinc-100'}`}>
                Contacto
            </a>
        </div>
    </div>
</header>

<script>
    const menuBtn = document.getElementById('menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');

    if (menuBtn && mobileMenu) {
        menuBtn.addEventListener('click', () => {
            mobileMenu.classList.toggle('hidden');
        });
    }
</script>