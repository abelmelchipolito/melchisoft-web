---
// Le preguntamos a Astro en qué página está el usuario actualmente (ej: '/servicios')
const rutaActual = Astro.url.pathname;
---
<nav class="fixed w-full bg-zinc-950/80 backdrop-blur-md border-b border-zinc-800/50 z-50">
    <!-- INICIA EL CONTENEDOR FLEX (Debe envolver al logo, menú de PC y botón) -->
    <div class="flex justify-between items-center py-6 px-8 md:px-16">
        
        <a href="/" class="text-lg font-semibold tracking-wide text-zinc-100 hover:text-white transition-colors">Melchisoft</a>
        
        <!-- Menú de PC -->
        <ul class="hidden md:flex gap-10 items-center text-sm">
            <li>
                <a href="/servicios" class={`transition-colors ${rutaActual.startsWith('/servicios') ? 'text-zinc-100 font-medium' : 'text-zinc-400 hover:text-zinc-100'}`}>
                    Servicios
                </a>
            </li>
            <li>
                <a href="/proyectos" class={`transition-colors ${rutaActual.startsWith('/proyectos') ? 'text-zinc-100 font-medium' : 'text-zinc-400 hover:text-zinc-100'}`}>
                    Proyectos
                </a>
            </li>
            <li>
                <a href="/contacto" class={`transition-colors ${rutaActual.startsWith('/contacto') ? 'text-zinc-100 font-medium' : 'text-zinc-400 hover:text-zinc-100'}`}>
                    Contacto
                </a>
            </li>
        </ul>

        <!-- Botón de 3 líneas para Celular (AHORA ESTÁ ADENTRO Y SIN "block") -->
        <button id="menu-btn" aria-label="Abrir menú" class="md:hidden text-zinc-300 hover:text-white focus:outline-none">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
        </button>

    </div> <!-- AQUÍ CIERRA EL CONTENEDOR FLEX (Después del botón) -->
        
    <!-- Menú Desplegable de Celular -->
    <div id="mobile-menu" class="hidden md:hidden bg-zinc-950 border-t border-zinc-800/50">
        <ul class="flex flex-col items-center py-6 gap-6 text-sm">
            <li>
                <a href="/servicios" class={`block transition-colors ${rutaActual.startsWith('/servicios') ? 'text-zinc-100 font-medium' : 'text-zinc-400 hover:text-zinc-100'}`}>
                    Servicios
                </a>
            </li>
            <li>
                <a href="/proyectos" class={`block transition-colors ${rutaActual.startsWith('/proyectos') ? 'text-zinc-100 font-medium' : 'text-zinc-400 hover:text-zinc-100'}`}>
                    Proyectos
                </a>
            </li>
            <li>
                <a href="/contacto" class={`block transition-colors ${rutaActual.startsWith('/contacto') ? 'text-zinc-100 font-medium' : 'text-zinc-400 hover:text-zinc-100'}`}>
                    Contacto
                </a>
            </li>
        </ul>
    </div>
</nav>

<script>
    const btn = document.getElementById('menu-btn');
    const menu = document.getElementById('mobile-menu');

    if (btn && menu) {
        btn.addEventListener('click', () => {
            menu.classList.toggle('hidden');
        });
    }
</script>