---
// Obtenemos el año actual de forma automática para el Copyright
const currentYear = new Date().getFullYear();
---

<footer class="bg-zinc-950 border-t border-zinc-800/50 pt-20 pb-10 px-8 md:px-16 relative overflow-hidden">
    
    <!-- Brillo sutil de fondo para darle profundidad -->
    <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[500px] h-[300px] bg-emerald-500/5 blur-[120px] rounded-full pointer-events-none"></div>

    <div class="max-w-7xl mx-auto relative z-10">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-16">
            
            <!-- Columna 1: Marca y Filosofía -->
            <div class="lg:col-span-1">
                <a href="/" class="inline-block text-2xl font-bold text-zinc-100 mb-6 tracking-tight">
                    Melchisoft
                </a>
                <p class="text-zinc-400 text-sm font-light leading-relaxed mb-6">
                    Estudio de desarrollo web especializado en crear experiencias rápidas, limpias y corporativas para negocios que buscan destacar.
                </p>
                <div class="flex items-center gap-4">
                    <!-- Icono Github (puedes enlazar tu perfil real aquí) -->
                    <a href="https://github.com/" target="_blank" rel="noopener noreferrer" class="text-zinc-500 hover:text-emerald-400 transition-colors">
                        <span class="sr-only">GitHub</span>
                        <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"></path></svg>
                    </a>
                </div>
            </div>

            <!-- Columna 2: Navegación Rápida -->
            <div>
                <h3 class="text-zinc-100 font-medium mb-6 tracking-wide">Navegación</h3>
                <ul class="space-y-4">
                    <li><a href="/" class="text-zinc-400 hover:text-emerald-400 text-sm transition-colors">Inicio</a></li>
                    <li><a href="/servicios" class="text-zinc-400 hover:text-emerald-400 text-sm transition-colors">Servicios y Precios</a></li>
                    <li><a href="/nosotros" class="text-zinc-400 hover:text-emerald-400 text-sm transition-colors">Sobre Nosotros</a></li>
                </ul>
            </div>

            <!-- Columna 3: Paquetes Destacados -->
            <div>
                <h3 class="text-zinc-100 font-medium mb-6 tracking-wide">Soluciones</h3>
                <ul class="space-y-4">
                    <li><a href="/servicios" class="text-zinc-400 hover:text-emerald-400 text-sm transition-colors">Landing Page</a></li>
                    <li><a href="/servicios" class="text-zinc-400 hover:text-emerald-400 text-sm transition-colors">Sitio Web</a></li>
                    <li><a href="/contacto" class="text-zinc-400 hover:text-emerald-400 text-sm transition-colors">Proyectos a la medida</a></li>
                </ul>
            </div>

            <!-- Columna 4: Contacto Directo -->
            <div>
                <h3 class="text-zinc-100 font-medium mb-6 tracking-wide">Contacto</h3>
                <ul class="space-y-4">
                    <li>
                        <!-- Botón sutil a WhatsApp usando el número que configuramos antes -->
                        <a href="https://wa.me/522941025503?text=Hola,%20me%20gustaría%20cotizar%20un%20proyecto%20web." target="_blank" rel="noopener noreferrer" class="text-zinc-400 hover:text-emerald-400 text-sm transition-colors flex items-center gap-3">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
                            WhatsApp Directo
                        </a>
                    </li>
                    <li>
                        <a href="/contacto" class="text-zinc-400 hover:text-emerald-400 text-sm transition-colors flex items-center gap-3">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                            Formulario de contacto
                        </a>
                    </li>
                    <li class="mt-8">
                        <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-medium uppercase tracking-widest">
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                            Disponibilidad Inmediata
                        </span>
                    </li>
                </ul>
            </div>

        </div>

        <!-- Barra Inferior: Derechos y Créditos -->
        <div class="pt-8 border-t border-zinc-800/50 flex flex-col md:flex-row justify-between items-center gap-4">
            <p class="text-zinc-500 text-sm font-light">
                &copy; {currentYear} Melchisoft. Todos los derechos reservados.
            </p>
            <p class="text-zinc-500 text-sm font-light flex items-center gap-1.5">
                Desarrollado con orgullo en <span class="text-zinc-300 font-medium">Los Tuxtlas</span>
            </p>
        </div>
    </div>
</footer>