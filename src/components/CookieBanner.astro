---
<!-- El aviso empieza oculto por defecto con la clase 'hidden' -->
<div id="cookie-banner" class="fixed bottom-0 left-0 w-full bg-zinc-900 border-t border-zinc-800 p-4 md:p-6 z-50 hidden justify-between items-center flex-col md:flex-row gap-4 shadow-2xl">
    
    <p class="text-zinc-400 text-sm font-light max-w-4xl text-center md:text-left">
        Utilizamos cookies para entender cómo interactúas con nuestro sitio web y brindarte una mejor experiencia. Al continuar navegando, aceptas nuestra política de privacidad.
    </p>
    
    <button id="accept-cookies" class="bg-zinc-100 text-zinc-950 hover:bg-white px-8 py-2.5 rounded-full text-sm font-semibold transition-all w-full md:w-auto shadow-lg shadow-zinc-100/10">
        Entendido
    </button>
    
</div>

<script>
    // Buscamos los elementos en el HTML
    const banner = document.getElementById('cookie-banner');
    const acceptBtn = document.getElementById('accept-cookies');

    // Verificamos que los elementos existan antes de hacer nada
    if (banner && acceptBtn) {
        
        // 1. Verificamos la memoria del navegador (localStorage)
        if (!localStorage.getItem('cookiesAceptadas')) {
            banner.classList.remove('hidden');
            banner.classList.add('flex');
        }

        // 2. Escuchamos el clic en el botón
        acceptBtn.addEventListener('click', () => {
            localStorage.setItem('cookiesAceptadas', 'true');
            banner.classList.add('hidden');
            banner.classList.remove('flex');
        });
    }
</script>