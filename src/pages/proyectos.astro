---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
---

<Layout>
    <Nav />
    
    <section class="py-24 px-8 md:px-16 bg-zinc-950 pt-32">
        <div class="max-w-6xl mx-auto">
            <div class="mb-16 text-center">
                <h2 class="text-3xl md:text-5xl font-medium text-zinc-100 mb-6">Proyectos y Soluciones</h2>
                <p class="text-zinc-400 text-lg max-w-2xl mx-auto">Diseñamos soluciones digitales escalables, optimizadas para rendimiento y pensadas para hacer crecer tu negocio.</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <!-- Card 1 -->
                <div class="bg-zinc-900/30 border border-zinc-800 p-8 rounded-3xl hover:border-zinc-600 transition-all duration-300">
                    <div class="h-12 w-12 bg-zinc-800 rounded-xl mb-6 flex items-center justify-center text-zinc-300">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-2m-9-2H3m14 0h2m-2 0h-2m-2 2H7"></path></svg>
                    </div>
                    <h3 class="text-xl font-semibold text-zinc-100 mb-3">Sitios Corporativos</h3>
                    <p class="text-zinc-400 font-light text-sm leading-relaxed">Presencia digital profesional. Diseños limpios, adaptables a móviles y optimizados para transmitir confianza a tus clientes.</p>
                </div>

                <!-- Card 2 -->
                <div class="bg-zinc-900/30 border border-zinc-800 p-8 rounded-3xl hover:border-zinc-600 transition-all duration-300">
                    <div class="h-12 w-12 bg-zinc-800 rounded-xl mb-6 flex items-center justify-center text-zinc-300">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg>
                    </div>
                    <h3 class="text-xl font-semibold text-zinc-100 mb-3">Landing Pages</h3>
                    <p class="text-zinc-400 font-light text-sm leading-relaxed">Estrategias enfocadas en resultados. Ideal para lanzamientos de productos, servicios específicos o campañas de marketing directo.</p>
                </div>

                <!-- Card 3 -->
                <div class="bg-zinc-900/30 border border-zinc-800 p-8 rounded-3xl hover:border-zinc-600 transition-all duration-300">
                    <div class="h-12 w-12 bg-zinc-800 rounded-xl mb-6 flex items-center justify-center text-zinc-300">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg>
                    </div>
                    <h3 class="text-xl font-semibold text-zinc-100 mb-3">Sistemas a Medida</h3>
                    <p class="text-zinc-400 font-light text-sm leading-relaxed">Infraestructura web compleja. Soluciones desarrolladas con lógica de ingeniería para automatizar procesos de tu negocio.</p>
                </div>
            </div>
        </div>
    </section>
</Layout>