---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
---

<Layout>
    <Nav />
    
    <header class="min-h-screen flex items-center pt-20 px-8 md:px-16 relative overflow-hidden">
        
        <!-- Luz de fondo Esmeralda (Glow) a la derecha -->
        <div class="absolute top-1/4 right-0 w-[600px] h-[600px] bg-emerald-500/10 blur-[150px] rounded-full pointer-events-none"></div>

        <div class="max-w-7xl mx-auto w-full grid lg:grid-cols-2 gap-12 items-center relative z-10">
            
            <!-- COLUMNA IZQUIERDA: Textos y Botones -->
            <div class="max-w-3xl">
                <div class="mb-8 flex items-center gap-3">
                    <span class="relative flex h-2.5 w-2.5">
                      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                      <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
                    </span>
                    <span class="text-xs font-medium text-zinc-400 uppercase tracking-widest">Disponible para nuevos proyectos</span>
                </div>
                
                <h1 class="text-5xl md:text-7xl font-medium tracking-tight mb-8 text-zinc-100 leading-[1.1]">
                    Creamos experiencias web <br class="hidden md:block" />
                    <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-emerald-600">rápidas, limpias y elegantes</span>
                </h1>
                
                <p class="text-lg text-zinc-400 max-w-xl mb-12 leading-relaxed font-light">
                    Ayudamos a los negocios a destacar en el mundo digital con diseños corporativos de vanguardia e infraestructura de alto rendimiento.
                </p>
                
                <div class="flex flex-col sm:flex-row gap-5">
                    <!-- Botón Principal con Hover Esmeralda -->
                    <a href="/contacto" class="bg-zinc-100 text-zinc-950 hover:bg-emerald-400 px-7 py-3.5 rounded-full text-sm font-semibold text-center transition-all duration-300 shadow-[0_0_0_rgba(52,211,153,0)] hover:shadow-[0_0_20px_rgba(52,211,153,0.4)]">
                        Iniciar un proyecto
                    </a>
                    <a href="/servicios" class="bg-transparent border border-zinc-800 text-zinc-300 hover:text-zinc-100 hover:border-zinc-700 px-7 py-3.5 rounded-full text-sm font-medium text-center transition-all">
                        Ver nuestros servicios
                    </a>
                </div>
            </div>

            <!-- COLUMNA DERECHA: Elemento Visual Premium (Solo visible en PC) -->
            <div class="hidden lg:flex justify-end relative">
                
                <!-- Tarjeta de cristal flotante -->
                <div class="relative w-[400px] rounded-3xl bg-zinc-900/40 backdrop-blur-xl border border-zinc-800/80 p-8 shadow-2xl hover:-translate-y-2 transition-transform duration-500">
                    
                    <!-- Botones estilo macOS -->
                    <div class="flex items-center gap-2 mb-8">
                        <div class="w-3 h-3 rounded-full bg-zinc-700"></div>
                        <div class="w-3 h-3 rounded-full bg-zinc-700"></div>
                        <div class="w-3 h-3 rounded-full bg-zinc-700"></div>
                    </div>
                    
                    <!-- Líneas de "código" animadas -->
                    <div class="space-y-4 mb-10 opacity-70">
                        <div class="h-2.5 w-24 bg-zinc-700 rounded-full"></div>
                        <div class="h-2.5 w-full bg-zinc-800 rounded-full"></div>
                        <div class="h-2.5 w-4/5 bg-zinc-800 rounded-full"></div>
                        <div class="h-2.5 w-full bg-zinc-800 rounded-full"></div>
                    </div>
                    
                    <!-- Medidor de Rendimiento 100% -->
                    <div class="flex items-center gap-6 p-4 rounded-2xl bg-zinc-950/50 border border-zinc-800/50">
                        <div class="relative flex items-center justify-center w-16 h-16 rounded-full border-4 border-emerald-500 shadow-[0_0_15px_rgba(52,211,153,0.2)] text-emerald-400 font-bold text-xl">
                            100
                        </div>
                        <div>
                            <p class="text-zinc-100 font-medium">Rendimiento Perfecto</p>
                            <p class="text-zinc-500 text-sm">Optimizado para SEO y Ventas</p>
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </header>

    <!-- SECCIÓN 1: BENEFICIOS -->
    <section class="px-8 md:px-16 py-24 border-t border-zinc-800/50 bg-zinc-950/50">
        <div class="max-w-6xl mx-auto">
            <h2 class="text-3xl md:text-4xl font-medium text-zinc-100 mb-12 tracking-tight">
                Diseño que destaca, <br><span class="text-zinc-500">rendimiento que convierte.</span>
            </h2>
            
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <!-- Beneficio 1 -->
                <div class="p-8 rounded-3xl bg-zinc-900/40 border border-zinc-800/50 hover:bg-zinc-900/80 transition-colors">
                    <div class="h-12 w-12 rounded-full bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center mb-6 text-emerald-400">
                        <!-- Tu SVG del rayo va aquí (quítale el class="text-zinc-300") -->
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                        </svg>
                    </div>
                    <h3 class="text-xl font-medium text-zinc-100 mb-3">Velocidad Extrema</h3>
                    <p class="text-zinc-400 text-sm leading-relaxed">
                        Desarrollamos con tecnología moderna para que tu sitio cargue en menos de un segundo, evitando que tus clientes se desesperen y se vayan.
                    </p>
                </div>

                <!-- Beneficio 2 -->
                <div class="p-8 rounded-3xl bg-zinc-900/40 border border-zinc-800/50 hover:bg-zinc-900/80 transition-colors">
                    <div class="h-12 w-12 rounded-full bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center mb-6 text-emerald-400">
                        <!-- Tu SVG del celular va aquí -->
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10.5 1.5H8.25A2.25 2.25 0 006 3.75v16.5a2.25 2.25 0 002.25 2.25h7.5A2.25 2.25 0 0018 20.25V3.75a2.25 2.25 0 00-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3"></path>
                        </svg>
                    </div>
                    <h3 class="text-xl font-medium text-zinc-100 mb-3">Diseño Responsivo</h3>
                    <p class="text-zinc-400 text-sm leading-relaxed">
                        Más del 80% de las visitas vienen de celulares. Tu sitio se verá y funcionará perfecto en cualquier pantalla o dispositivo.
                    </p>
                </div>

                <!-- Beneficio 3 -->
                <div class="p-8 rounded-3xl bg-zinc-900/40 border border-zinc-800/50 hover:bg-zinc-900/80 transition-colors">
                    <div class="h-12 w-12 rounded-full bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center mb-6 text-emerald-400">
                        <!-- Tu SVG de la gráfica va aquí -->
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z"></path>
                        </svg>
                    </div>
                    <h3 class="text-xl font-medium text-zinc-100 mb-3">Enfocado en Ventas</h3>
                    <p class="text-zinc-400 text-sm leading-relaxed">
                        No hacemos páginas de adorno. Diseñamos estructuras probadas para convertir a tus visitantes en clientes potenciales de WhatsApp.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- SECCIÓN INTERMEDIA: PAQUETES / SERVICIOS -->
    <section class="px-8 md:px-16 py-24 border-t border-zinc-800/50">
        <div class="max-w-6xl mx-auto">
            <!-- Encabezado de la sección -->
            <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6">
                <div>
                    <h2 class="text-3xl md:text-4xl font-medium text-zinc-100 mb-4 tracking-tight">
                        Soluciones digitales <br><span class="text-zinc-500">para cada necesidad</span>
                    </h2>
                    <p class="text-zinc-400 text-lg max-w-xl font-light">
                        Desde páginas de alta velocidad para conseguir clientes hoy mismo, hasta sitios corporativos completos.
                    </p>
                </div>
                <a href="/servicios" class="text-zinc-300 hover:text-white flex items-center gap-2 text-sm font-medium transition-colors">
                    Ver todos los detalles
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                </a>
            </div>

            <!-- Contenedor de las Tarjetas -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                
                <!-- Tarjeta 1: Landing Page (Destacada con Esmeralda) -->
                <div class="group relative p-8 md:p-10 rounded-3xl bg-zinc-900/40 border border-zinc-800/80 hover:border-emerald-500/50 transition-all duration-300 hover:-translate-y-1 overflow-hidden">
                    <!-- Ícono de fondo sutil -->
                    <div class="absolute top-0 right-0 p-8 opacity-5 group-hover:opacity-10 transition-opacity">
                        <svg class="w-24 h-24 text-emerald-500" fill="currentColor" viewBox="0 0 24 24"><path d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                    </div>
                    
                    <!-- Etiqueta de "Más Popular" -->
                    <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-medium mb-6">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                        Recomendado para negocios locales
                    </div>
                    
                    <h3 class="text-2xl font-medium text-zinc-100 mb-3">Landing Page Express</h3>
                    <p class="text-zinc-400 mb-8 max-w-sm leading-relaxed">
                        Una página de aterrizaje de alto impacto diseñada con un solo objetivo: convertir visitantes en clientes directos en tu WhatsApp.
                    </p>
                    
                    <ul class="space-y-4 mb-10 text-sm text-zinc-300">
                        <li class="flex items-center gap-3"><svg class="w-5 h-5 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> Diseño premium de 1 sola página</li>
                        <li class="flex items-center gap-3"><svg class="w-5 h-5 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> Botón flotante para WhatsApp</li>
                        <li class="flex items-center gap-3"><svg class="w-5 h-5 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> Entrega rápida en 3 a 5 días</li>
                    </ul>
                    
                    <a href="/servicios" class="inline-block w-full py-3.5 rounded-xl bg-zinc-100 text-zinc-950 font-semibold text-sm text-center hover:bg-white transition-colors relative z-10">
                        Me interesa este paquete
                    </a>
                </div>

                <!-- Tarjeta 2: Sitio Corporativo (Estilo sobrio) -->
                <div class="group relative p-8 md:p-10 rounded-3xl bg-zinc-900/40 border border-zinc-800/50 hover:border-zinc-600 transition-all duration-300 hover:-translate-y-1 overflow-hidden">
                    <h3 class="text-2xl font-medium text-zinc-100 mb-3 mt-10">Sitio Web Corporativo</h3>
                    <p class="text-zinc-400 mb-8 max-w-sm leading-relaxed">
                        Un ecosistema digital completo de múltiples secciones para empresas que buscan proyectar máxima autoridad y confianza.
                    </p>
                    
                    <ul class="space-y-4 mb-10 text-sm text-zinc-300">
                        <li class="flex items-center gap-3"><svg class="w-5 h-5 text-zinc-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> Hasta 5 páginas internas (Servicios, Nosotros, etc.)</li>
                        <li class="flex items-center gap-3"><svg class="w-5 h-5 text-zinc-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> Formulario de contacto avanzado</li>
                        <li class="flex items-center gap-3"><svg class="w-5 h-5 text-zinc-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> Optimización SEO para Google</li>
                    </ul>
                    
                    <a href="/servicios" class="inline-block w-full py-3.5 rounded-xl bg-transparent border border-zinc-700 text-zinc-300 font-medium text-sm text-center hover:text-white hover:border-zinc-500 transition-colors relative z-10">
                        Me interesa este paquete
                    </a>
                </div>
                
            </div>
        </div>
    </section>

    <!-- SECCIÓN DE CONCIENTIZACIÓN (¿Por qué necesitas una web?) -->
    <section class="px-8 md:px-16 py-24 border-t border-zinc-800/50 bg-zinc-950/20 relative">
        <!-- Detalle de luz tenue -->
        <div class="absolute left-0 top-1/2 -translate-y-1/2 w-[300px] h-[300px] bg-emerald-500/5 blur-[100px] rounded-full pointer-events-none"></div>

        <div class="max-w-6xl mx-auto">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
                
                <!-- Columna Izquierda: El problema -->
                <div class="relative z-10">
                    <h2 class="text-3xl md:text-5xl font-medium text-zinc-100 mb-6 tracking-tight leading-[1.1]">
                        Tener solo redes sociales <br> <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-emerald-600">ya no es suficiente.</span>
                    </h2>
                    <p class="text-zinc-400 text-lg leading-relaxed font-light mb-8">
                        Tus clientes potenciales buscan en Google antes de tomar una decisión de compra. Un sitio web profesional es la diferencia entre ser una opción más o posicionarte como la máxima autoridad de tu sector.
                    </p>
                    <div class="flex items-center gap-4 text-zinc-300 text-sm font-medium bg-zinc-900/50 border border-zinc-800 w-fit px-5 py-3 rounded-full">
                        <span class="flex items-center justify-center w-6 h-6 rounded-full bg-emerald-500/20">
                            <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
                        </span>
                        Tú tienes el control total, no dependes de algoritmos.
                    </div>
                </div>
                
                <!-- Columna Derecha: Los Datos (Tarjetas) -->
                <div class="grid grid-cols-1 gap-6 relative z-10">
                    <!-- Dato 1 -->
                    <div class="p-8 rounded-3xl bg-zinc-900/60 border border-zinc-800/80 hover:border-zinc-700 transition-colors backdrop-blur-sm">
                        <h4 class="text-emerald-400 font-bold text-3xl mb-3 flex items-center gap-3">
                            24/7
                            <span class="block w-full h-px bg-zinc-800/80"></span>
                        </h4>
                        <h5 class="text-zinc-100 font-medium mb-2">Ventas sin interrupción</h5>
                        <p class="text-zinc-400 text-sm leading-relaxed font-light">Tu negocio se mantiene abierto todo el tiempo. Resuelve dudas frecuentes, muestra tus servicios y recibe mensajes de prospectos incluso mientras duermes.</p>
                    </div>
                    
                    <!-- Dato 2 (Ligeramente desplazado para darle un toque moderno) -->
                    <div class="p-8 rounded-3xl bg-zinc-900/60 border border-zinc-800/80 hover:border-zinc-700 transition-colors backdrop-blur-sm lg:ml-12">
                        <h4 class="text-emerald-400 font-bold text-3xl mb-3 flex items-center gap-3">
                            +75%
                            <span class="block w-full h-px bg-zinc-800/80"></span>
                        </h4>
                        <h5 class="text-zinc-100 font-medium mb-2">Confianza inmediata</h5>
                        <p class="text-zinc-400 text-sm leading-relaxed font-light">De los usuarios juzgan la credibilidad de una empresa basándose únicamente en la calidad visual y la velocidad de su sitio web.</p>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- SECCIÓN DE PREGUNTAS FRECUENTES (FAQ) ANIMADA -->
    <section class="px-8 md:px-16 py-32 border-t border-zinc-800/50 bg-zinc-950">
        <div class="max-w-4xl mx-auto">
            
            <div class="text-center mb-16">
                <h2 class="text-3xl md:text-5xl font-medium text-zinc-100 mb-6 tracking-tight">
                    Preguntas <span class="text-zinc-500">Frecuentes</span>
                </h2>
                <p class="text-zinc-400 text-lg font-light">
                    Resolvemos tus dudas principales para que des el paso con total seguridad.
                </p>
            </div>

            <!-- Contenedor del Acordeón -->
            <div class="space-y-4">
                
                <!-- Pregunta 1 -->
                <div class="faq-item border border-zinc-800/80 bg-zinc-900/20 rounded-2xl overflow-hidden hover:border-zinc-700 transition-colors">
                    <button class="faq-button w-full flex justify-between items-center p-6 font-medium text-left text-zinc-100 text-lg focus:outline-none">
                        <span>¿Tengo que pagar mensualidades por mi página web?</span>
                        <span class="faq-icon transition-transform duration-500 text-emerald-500">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                        </span>
                    </button>
                    <!-- El truco del Grid: grid-rows-[0fr] mantiene la altura en cero, grid-rows-[1fr] lo expande suavemente -->
                    <div class="faq-answer grid grid-rows-[0fr] transition-[grid-template-rows] duration-500 ease-in-out">
                        <div class="overflow-hidden">
                            <p class="text-zinc-400 font-light leading-relaxed text-sm md:text-base border-t border-zinc-800/50 p-6 pt-4 mt-0">
                                <strong class="text-zinc-300 font-medium">No cobramos mensualidades por el diseño.</strong> El pago de tu paquete web es único. Sin embargo, para que tu página viva en internet requiere de un <span class="text-emerald-400">Dominio</span> (tu nombre .com) y un <span class="text-emerald-400">Hosting</span> (el servidor). Nosotros incluimos el primer año de alojamiento, después solo tendrás que cubrir la renovación anual del servidor, que suele ser muy accesible.
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Pregunta 2 -->
                <div class="faq-item border border-zinc-800/80 bg-zinc-900/20 rounded-2xl overflow-hidden hover:border-zinc-700 transition-colors">
                    <button class="faq-button w-full flex justify-between items-center p-6 font-medium text-left text-zinc-100 text-lg focus:outline-none">
                        <span>¿Qué información necesito entregarles para empezar?</span>
                        <span class="faq-icon transition-transform duration-500 text-emerald-500">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                        </span>
                    </button>
                    <div class="faq-answer grid grid-rows-[0fr] transition-[grid-template-rows] duration-500 ease-in-out">
                        <div class="overflow-hidden">
                            <p class="text-zinc-400 font-light leading-relaxed text-sm md:text-base border-t border-zinc-800/50 p-6 pt-4 mt-0">
                                Para iniciar tu proyecto únicamente necesitamos que nos platiques sobre tu negocio. Te pediremos tu <strong>logotipo</strong> (si lo tienes), fotografías de tus productos/servicios y los textos básicos (nosotros te ayudamos a redactarlos para que sean atractivos para vender).
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Pregunta 3 -->
                <div class="faq-item border border-zinc-800/80 bg-zinc-900/20 rounded-2xl overflow-hidden hover:border-zinc-700 transition-colors">
                    <button class="faq-button w-full flex justify-between items-center p-6 font-medium text-left text-zinc-100 text-lg focus:outline-none">
                        <span>¿Mi página aparecerá en Google?</span>
                        <span class="faq-icon transition-transform duration-500 text-emerald-500">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                        </span>
                    </button>
                    <div class="faq-answer grid grid-rows-[0fr] transition-[grid-template-rows] duration-500 ease-in-out">
                        <div class="overflow-hidden">
                            <p class="text-zinc-400 font-light leading-relaxed text-sm md:text-base border-t border-zinc-800/50 p-6 pt-4 mt-0">
                                ¡Sí! Desarrollamos todas nuestras páginas con <strong>Astro</strong>, una tecnología moderna que garantiza velocidades de carga extremas. Google ama las páginas rápidas, por lo que aplicamos buenas prácticas de SEO técnico desde el código base para que los buscadores puedan leer e indexar tu sitio correctamente.
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Pregunta 4 -->
                <div class="faq-item border border-zinc-800/80 bg-zinc-900/20 rounded-2xl overflow-hidden hover:border-zinc-700 transition-colors">
                    <button class="faq-button w-full flex justify-between items-center p-6 font-medium text-left text-zinc-100 text-lg focus:outline-none">
                        <span>¿Qué pasa si ya tengo un dominio comprado?</span>
                        <span class="faq-icon transition-transform duration-500 text-emerald-500">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                        </span>
                    </button>
                    <div class="faq-answer grid grid-rows-[0fr] transition-[grid-template-rows] duration-500 ease-in-out">
                        <div class="overflow-hidden">
                            <p class="text-zinc-400 font-light leading-relaxed text-sm md:text-base border-t border-zinc-800/50 p-6 pt-4 mt-0">
                                No hay ningún problema. Si ya compraste tu dominio (por ejemplo, en Hostinger, GoDaddy o Namecheap), nosotros nos encargamos de configurarlo y enlazarlo a tu nueva página web sin costo extra. Tú mantienes el control total de tu propiedad digital en todo momento.
                            </p>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- Script para darle vida a la animación -->
    <script>
        // Esperamos a que el DOM esté listo
        document.addEventListener('DOMContentLoaded', () => {
            const faqItems = document.querySelectorAll('.faq-item');

            faqItems.forEach(item => {
                const button = item.querySelector('.faq-button');
                const answer = item.querySelector('.faq-answer');
                const icon = item.querySelector('.faq-icon');

                // Verificamos que los elementos existan para que TypeScript no marque error
                if (button && answer && icon) {
                    button.addEventListener('click', () => {
                        const isOpen = answer.classList.contains('grid-rows-[1fr]');

                        // 1. Cerramos todas las respuestas primero (Efecto Acordeón)
                        document.querySelectorAll('.faq-answer').forEach(a => {
                            a.classList.remove('grid-rows-[1fr]');
                            a.classList.add('grid-rows-[0fr]');
                        });
                        
                        // Rotamos todas las flechas a su estado original
                        document.querySelectorAll('.faq-icon').forEach(i => {
                            i.classList.remove('rotate-180');
                        });

                        // 2. Si la que clickeamos estaba cerrada, la abrimos
                        if (!isOpen) {
                            answer.classList.remove('grid-rows-[0fr]');
                            answer.classList.add('grid-rows-[1fr]');
                            icon.classList.add('rotate-180');
                        }
                    });
                }
            });
        });
    </script>

    <!-- SECCIÓN 2: CTA FINAL -->
    <section class="px-8 md:px-16 py-32 border-t border-zinc-800/50 relative overflow-hidden">
        <!-- Efecto de brillo de fondo suave -->
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 bg-emerald-500/10 blur-[100px] rounded-full pointer-events-none"></div>
        
        <div class="max-w-3xl mx-auto text-center relative z-10">
            <h2 class="text-4xl md:text-5xl font-medium text-zinc-100 mb-6 tracking-tight">
                ¿Listo para tu nueva web?
            </h2>
            <p class="text-lg text-zinc-400 mb-10 font-light">
                Cuéntanos sobre tu negocio y te ayudaremos a construir la presencia digital que mereces.
            </p>
            <a href="/contacto" class="inline-block bg-zinc-100 text-zinc-950 hover:bg-white px-8 py-4 rounded-full text-sm font-semibold transition-all shadow-[0_0_40px_rgba(255,255,255,0.1)] hover:shadow-[0_0_60px_rgba(255,255,255,0.2)]">
                Empezar mi proyecto ahora
            </a>
        </div>
    </section>
</Layout>