---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
---

<Layout>
    <Nav />
    
    <!-- Usamos un contenedor relativo con overflow oculto para que el brillo no se salga de la pantalla -->
    <main class="min-h-screen pt-32 pb-16 px-8 md:px-16 flex items-center justify-center relative overflow-hidden">
        
        <!-- Efecto de iluminación de fondo (Glow Esmeralda súper suave) -->
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-emerald-500/5 blur-[120px] rounded-full pointer-events-none"></div>

        <div class="max-w-3xl w-full relative z-10">
            <!-- Tarjeta Principal (Glassmorphism) -->
            <div class="group bg-zinc-900/40 backdrop-blur-xl border border-zinc-800/80 rounded-[2.5rem] p-10 md:p-16 text-center hover:border-zinc-700/80 hover:bg-zinc-900/60 transition-all duration-700 flex flex-col items-center shadow-2xl shadow-black/50">
                
                <!-- Contenedor del Ícono con resplandor -->
                <div class="relative mb-10">
                    <!-- Brillo que se activa al hacer hover en la tarjeta -->
                    <div class="absolute inset-0 bg-emerald-500/20 rounded-full blur-xl group-hover:bg-emerald-500/40 transition-colors duration-700"></div>
                    <!-- Círculo principal -->
                    <div class="relative h-20 w-20 bg-zinc-950 border border-zinc-800 text-emerald-400 rounded-full flex items-center justify-center shadow-xl">
                        <svg class="w-10 h-10" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>
                        </svg>
                    </div>
                </div>

                <h1 class="text-4xl md:text-5xl font-medium text-zinc-100 mb-6 tracking-tight">
                    Iniciemos tu <span class="text-zinc-500">proyecto</span>
                </h1>
                <p class="text-zinc-400 font-light text-lg mb-12 max-w-xl mx-auto leading-relaxed">
                    Creemos en la comunicación directa y sin fricciones. Escríbenos por WhatsApp, cuéntanos tu idea y recibe asesoría para escalar tu presencia digital.
                </p>
                
                <!-- Botón Principal Premium -->
                <a href="https://wa.me/522941025503?text=Hola,%20me%20gustaría%20cotizar%20un%20proyecto%20web." target="_blank" rel="noopener noreferrer" class="relative inline-flex items-center justify-center gap-3 bg-zinc-100 text-zinc-950 hover:bg-white px-8 py-4 rounded-full text-sm font-semibold transition-all duration-300 hover:-translate-y-1 shadow-[0_0_20px_rgba(255,255,255,0.05)] hover:shadow-[0_0_40px_rgba(255,255,255,0.2)]">
                    Iniciar chat en WhatsApp
                </a>
            </div>
        </div>
    </main>
</Layout>