---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
---

<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Melchisoft | Estudio de Desarrollo Web</title>
    <meta name="google-site-verification" content="cwidJY5LaGFZqXdSfqoO03-SZryXssr8rlQrF8D3WKM" />
    <!-- Favicon -->
    <link rel="icon" type="image/png" sizes="192x192" href="https://www.melchisoft.com/favicon.png" />
</head>
<body class="bg-zinc-950 text-zinc-50 font-sans antialiased selection:bg-zinc-200 selection:text-zinc-900 flex flex-col min-h-screen">
    
    <main class="flex-grow">
        <slot />
    </main>
    
    <Footer />
    
    <!-- Inyectamos el aviso global de cookies al final -->
    <CookieBanner />
    
</body>
</html>